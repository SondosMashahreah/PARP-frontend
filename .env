# Optional. Leave empty to prepare messages in the visitor's email app.
# This is a PUBLIC URL, never put secrets in a VITE_ variable.
# Expects POST { name, email, subject, message } and a non-2xx status on failure.
VITE_CONTACT_ENDPOINT=

# Public URL of the FastAPI backend. Never put API keys in VITE_ variables.
VITE_API_URL=http://localhost:8000
